{
  "name": "larica-app",
  "compatibility_date": "2026-08-24",
  "main": "worker/index.ts",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "RATE_LIMIT_DELIVERY", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RATE_LIMIT_COUPON", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_ORDER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ]
}
